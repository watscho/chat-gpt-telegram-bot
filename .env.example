# Create a bot with @BotFather. Never commit real credentials.
TELEGRAM_API_KEY=
OPENAI_API_KEY=
# Optional override: defaults to gpt-6.1-sol; requires access in your OpenAI project.
OPENAI_CHAT_MODEL=gpt-6.1-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Required: comma-separated numeric Telegram user IDs. Private chats only.
ALLOWED_TELEGRAM_USER_IDS=
# Optional limits (defaults shown)
MAX_INPUT_CHARACTERS=8000
MAX_HISTORY_TURNS=20
MAX_HISTORY_CHARACTERS=60000
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
MAX_CONCURRENT_REQUESTS=10
MAX_VOICE_BYTES=10000000
MAX_VOICE_SECONDS=300
OPENAI_MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT_MS=60000
# Photos: chat model must support vision AND the Responses image_generation tool.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
# auto | 1024x1024 | 1536x1024 | 1024x1536
OPENAI_IMAGE_SIZE=auto
IMAGE_TIMEOUT_MS=300000
# Binary file limit; history budgets count base64 characters (encoded bytes).
MAX_IMAGE_BYTES=10000000
MAX_HISTORY_IMAGE_BYTES=20000000
MAX_TOTAL_IMAGE_BYTES=64000000
# Pro features: local state, explicit saved notes, documents, web and voice replies.
# Use :memory: for disposable state. Keep the SQLite database private and backed up.
STATE_DB_PATH=./data/bot.sqlite
MAX_THREADS=20
MAX_MEMORIES=20
MAX_MEMORY_CHARACTERS=4000
MAX_DOCUMENT_BYTES=10000000
# Shared tool-call budget in automatic mode; /image and /edit allow one call.
MAX_WEB_SEARCH_CALLS=3
# Voice replies are off until /voice on or /voice auto. /speak is one-shot.
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
MAX_SPEECH_CHARACTERS=3000
MAX_SPEECH_BYTES=10000000
# FFmpeg with libopus is required for outgoing Telegram voice messages.
FFMPEG_PATH=ffmpeg

# Incremental Telegram text previews (true | false).
STREAM_RESPONSES=true
# UTC per-owner quotas. Micro-USD: 1000000 = $1. These are local estimates.
DAILY_BUDGET_MICRO_USD=10000000
DAILY_REQUESTS=100
DAILY_IMAGES=20
DAILY_SEARCHES=100
DAILY_VOICE=50
# Operator estimates per paid operation/tool call; not provider prices.
ESTIMATE_CHAT_MICRO_USD=100000
ESTIMATE_IMAGE_MICRO_USD=500000
ESTIMATE_SEARCH_MICRO_USD=10000
ESTIMATE_VOICE_MICRO_USD=100000
ESTIMATE_TRANSCRIPTION_MICRO_USD=100000
# Per-owner project/queue/export budgets; encoded attachments count toward bytes.
# MAX_JOB_BYTES also bounds each owner's independent Studio record.
MAX_PROJECTS=10
MAX_PROJECT_BYTES=20000000
MAX_JOBS=20
MAX_JOB_BYTES=20000000
MAX_SCHEDULES=20
MAX_EXPORT_BYTES=20000000
WORKER_INTERVAL_MS=1000

# Require an estimate/context confirmation before explicit images and ad-hoc jobs.
# Batches always require confirmation. true | false
CONFIRM_EXPENSIVE_REQUESTS=true

# Provider workbench: separate opt-in paid workflows; see docs/pro-provider.md.
OPENAI_ANALYSIS_MODEL=gpt-6-astra
OPENAI_MEETING_MODEL=gpt-transcribe
# Optional legacy speaker labeling; disabled by default. Verify deprecation/access.
OPENAI_DIARIZATION_MODEL=
OPENAI_LIVE_MODEL=gpt-realtime-2.1-mini
# Shared voice/workspace HTTPS URL/path proxied to loopback; build before enabling.
# /workspace opens the workspace/ child path; proxy shared static/API routes too.
MINI_APP_URL=
MINI_APP_PORT=8787
LIVE_MAX_SECONDS=180
MAX_MEETING_BYTES=20000000
MAX_MEETING_SECONDS=1800
# Operator-trusted authenticated remote MCP endpoints, scoped to numeric owners.
# Keep credentials in protected environment storage, never in chat or Git.
OPENAI_MCP_CONNECTIONS=[]
# Full configured estimates; these are not measured provider invoices.
ESTIMATE_ANALYSIS_MICRO_USD=1000000
ESTIMATE_INDEX_MICRO_USD=100000
ESTIMATE_CONNECTION_MICRO_USD=100000
ESTIMATE_LIVE_MINUTE_MICRO_USD=500000
ESTIMATE_MEETING_MINUTE_MICRO_USD=100000

# Pro Suite: allowlisted independent reviewers, bounded video and fixed estimates.
# Review must use a model different from the frozen primary answer model.
OPENAI_REVIEW_MODELS=gpt-6.1-sol,gpt-6-astra
ESTIMATE_REVIEW_EXTRA_MICRO_USD=100000
FFPROBE_PATH=ffprobe
MAX_VIDEO_BYTES=20000000
MAX_VIDEO_CLIP_SECONDS=120
MAX_VIDEO_FRAMES=8
