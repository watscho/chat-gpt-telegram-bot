# Create a bot with @BotFather. Never commit real credentials.
TELEGRAM_API_KEY=
OPENAI_API_KEY=
# Required: a Responses-compatible model available to your OpenAI project.
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Required: comma-separated numeric Telegram user IDs. Private chats only.
ALLOWED_TELEGRAM_USER_IDS=
# Optional limits (defaults shown)
MAX_INPUT_CHARACTERS=8000
MAX_HISTORY_TURNS=20
MAX_HISTORY_CHARACTERS=60000
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
MAX_CONCURRENT_REQUESTS=10
MAX_VOICE_BYTES=10000000
MAX_VOICE_SECONDS=300
OPENAI_MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT_MS=60000
# Photos: chat model must support vision AND the Responses image_generation tool.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
# auto | 1024x1024 | 1536x1024 | 1024x1536
OPENAI_IMAGE_SIZE=auto
IMAGE_TIMEOUT_MS=300000
# Binary file limit; history budgets count base64 characters (encoded bytes).
MAX_IMAGE_BYTES=10000000
MAX_HISTORY_IMAGE_BYTES=20000000
MAX_TOTAL_IMAGE_BYTES=64000000
# Pro features: local state, explicit saved notes, documents, web and voice replies.
# Use :memory: for disposable state. Keep the SQLite database private and backed up.
STATE_DB_PATH=./data/bot.sqlite
MAX_THREADS=20
MAX_MEMORIES=20
MAX_MEMORY_CHARACTERS=4000
MAX_DOCUMENT_BYTES=10000000
# Shared tool-call budget in automatic mode; /image and /edit allow one call.
MAX_WEB_SEARCH_CALLS=3
# Voice replies are off until /voice on or /voice auto. /speak is one-shot.
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
MAX_SPEECH_CHARACTERS=3000
MAX_SPEECH_BYTES=10000000
# FFmpeg with libopus is required for outgoing Telegram voice messages.
FFMPEG_PATH=ffmpeg
