{
  "name": "chat-gpt-telegram-bot",
  "version": "11.0.0",
  "private": true,
  "description": "A private TypeScript Telegram assistant with projects, streaming, usage controls, documents, image workflows, durable jobs and timezone-aware schedules.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "Vacho Aivazov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watscho/chat-gpt-telegram-bot.git"
  },
  "bugs": {
    "url": "https://github.com/watscho/chat-gpt-telegram-bot/issues"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "watch": "npm run dev",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-test-module-mocks --import tsx --test 'src/**/__tests__/*.test.ts'",
    "test:coverage": "node --experimental-test-module-mocks --import tsx --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test 'src/**/__tests__/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run docs:check && npm test && npm run build",
    "test:unit": "node --experimental-test-module-mocks --import tsx --test 'src/**/__tests__/*.test.ts'",
    "verify": "npm run check && npm run test:coverage && npm audit --audit-level=high",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "npm run hooks:install",
    "docs:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "docx": "9.15.2",
    "fast-xml-parser": "5.12.0",
    "openai": "7.50.0",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.20.2",
    "pptxgenjs": "4.0.1",
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.7",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
