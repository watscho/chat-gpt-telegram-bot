{
  "name": "chat-gpt-telegram-bot",
  "version": "2.0.0",
  "private": true,
  "description": "A TypeScript Telegram bot with isolated conversations and voice transcription.",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "Vacho Aivazov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watscho/chat-gpt-telegram-bot.git"
  },
  "bugs": {
    "url": "https://github.com/watscho/chat-gpt-telegram-bot/issues"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "watch": "npm run dev",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=85 --test-coverage-include=\"src/**/*.ts\" --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "openai": "7.50.0",
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
